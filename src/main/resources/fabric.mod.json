{
  "schemaVersion": 1,
  "id": "venti",
  "version": "${version}",
  "name": "Venti",
  "description": "A visual and quality-of-life client: smooth themeable GUI, Spotify HUD with synced lyrics, custom sky and totem images, 3D characters, waypoints and more.",
  "authors": [
    "mishoassenov10-prog"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.venti.VentiClient"
    ]
  },
  "mixins": [
    "venti.mixins.json",
    "venti.hitfx.mixins.json",
    "venti.character.mixins.json",
    "venti.hand.mixins.json",
    "venti.world.mixins.json",
    "venti.noinvleak.mixins.json",
    "venti.hud.mixins.json",
    "venti.view.mixins.json",
    "venti.waypoints.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "${minecraft}",
    "fabric-api": "*",
    "java": ">=21"
  },
  "contact": {
    "homepage": "https://github.com/mishoassenov10-prog/VentiClient",
    "sources": "https://github.com/mishoassenov10-prog/VentiClient",
    "issues": "https://github.com/mishoassenov10-prog/VentiClient/issues"
  }
}